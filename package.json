{
  "name": "portfolio",
  "version": "0.1.1",
  "homepage": "https://woods.engineer/",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": "22.x",
    "pnpm": ">=9.0.0"
  },
  "keywords": [
    "personal website"
  ],
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ],
    "plugins": [
      "unused-imports"
    ],
    "rules": {
      "unused-imports/no-unused-imports": "error"
    }
  },
  "jest": {
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/src/$1",
      "^(\\.{1,2}/.*)\\.js$": "$1"
    }
  },
  "scripts": {
    "start": "vite --port 8080 --strictPort",
    "dev": "vite --port 8080 --strictPort",
    "dev:api": "vite --port 8080 --strictPort",
    "build": "vite build",
    "test": "react-scripts test --watchAll=false --passWithNoTests",
    "eject": "react-scripts eject",
    "format": "biome format ./src --write",
    "lint": "biome lint ./src",
    "check": "biome check --write .",
    "sass:check": "sass --no-source-map --no-error-css --verbose src:public/build/css",
    "lint:md": "markdownlint-cli2 \"**/*.md\" \"#node_modules\"",
    "lint:md:fix": "markdownlint-cli2 --fix \"**/*.md\" \"#node_modules\"",
    "compress-images": "node scripts/compress-images.cjs",
    "sync:html": "node scripts/sync-html-heads.cjs",
    "sync:html:check": "node scripts/sync-html-heads.cjs --check",
    "verify:proof": "node scripts/verify-proof-vendor.mjs",
    "test:proof-vendor": "node --test scripts/verify-proof-vendor.node-test.mjs",
    "env:vercel": "pnpm dlx vercel env pull .env.vercel.development --yes --environment development",
    "env:vercel:prod": "pnpm dlx vercel env pull .env.vercel.production --yes --environment production",
    "build:dev": "vite build --mode development"
  },
  "dependencies": {
    "@babel/core": "^8.0.7",
    "@babel/plugin-transform-private-methods": "^7.28.6",
    "@eslint/config-array": "^0.23.4",
    "@eslint/object-schema": "^3.0.4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/react": "^19.3.0",
    "@vercel/analytics": "^1.6.1",
    "@vercel/kv": "^3.0.0",
    "@vercel/speed-insights": "^2.0.0",
    "@vitejs/plugin-react": "^6.1.2",
    "ajv": "^8.18.0",
    "ajv-keywords": "^5.1.0",
    "axios": "^1.20.0",
    "canvas-confetti": "^1.9.4",
    "chalk": "^6.0.1",
    "chroma-js": "^3.2.0",
    "clean-css": "^5.3.3",
    "compression-webpack-plugin": "^11.1.0",
    "cors": "^2.8.6",
    "deadfile": "^2.1.1",
    "eslint-config-react-app": "^7.0.1",
    "express": "^5.3.0",
    "gsap": "^3.14.2",
    "lovable-tagger": "^1.3.5",
    "ogl": "^1.0.11",
    "open": "^10.2.0",
    "postcss-cli": "^11.0.1",
    "prop-types": "^15.8.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-intersection-observer": "^11.0.1",
    "react-router-dom": "^7.18.4",
    "rimraf": "^6.1.3",
    "sass": "^1.105.1",
    "styled-components": "^6.5.3",
    "terser-webpack-plugin": "^5.6.1",
    "tone": "^15.1.22",
    "vite": "^8.3.4"
  },
  "bin": {
    "deadfile": "./deadfile.js"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@babel/eslint-parser": "^8.0.7",
    "@babel/plugin-proposal-private-property-in-object": "^7.21.11",
    "@biomejs/biome": "^2.5.15",
    "@svgr/webpack": "^8.1.0",
    "@testing-library/dom": "^10.4.2",
    "@types/chroma-js": "^3.1.2",
    "@types/jest": "^30.0.0",
    "@types/node": "^25.9.3",
    "@types/prop-types": "^15.7.15",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.6.1",
    "babel-eslint": "^10.1.0",
    "css-select": "^6.0.0",
    "depcheck": "^1.4.7",
    "dotenv": "^18.0.7",
    "eslint": "^10.12.0",
    "eslint-import-resolver-node": "^0.4.0",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-unused-imports": "^4.4.1",
    "husky": "^9.1.7",
    "imagemin": "^9.0.1",
    "imagemin-avif": "^0.1.6",
    "imagemin-mozjpeg": "^10.0.0",
    "imagemin-pngquant": "^10.0.0",
    "jest-watch-typeahead": "^2.2.2",
    "knip": "^6.41.0",
    "lint-staged": "^17.6.0",
    "markdownlint-cli2": "^0.23.3",
    "npm-check": "^6.0.1",
    "postcss": "^8.5.29",
    "prettier": "^3.9.9",
    "react-scripts": "^5.0.1",
    "resolve-url-loader": "^5.0.0",
    "sass-loader": "^17.0.0",
    "sharp": "^0.35.5",
    "stylelint": "^17.16.0",
    "stylelint-config-standard-scss": "^17.0.0",
    "stylelint-prettier": "^5.0.3",
    "stylelint-scss": "^7.3.0",
    "svgo": "^4.1.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  },
  "sassConfig": {
    "api": "modern",
    "sourceMap": true,
    "sourceMapEmbed": true
  },
  "resolutions": {
    "sass-loader": "^13.3.2",
    "postcss": "^8.5.6",
    "svgo": "^4.0.0",
    "css-select": "^6.0.0",
    "@svgr/webpack": "^8.1.0",
    "resolve-url-loader": "^5.0.0"
  },
  "overrides": {},
  "repository": {
    "type": "git",
    "url": "https://github.com/guitarbeat/Personal-Website"
  }
}
